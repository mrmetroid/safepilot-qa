# SafePilot QA: example .env for running everything locally on a laptop.
# EVERY VALUE HERE IS FAKE. This file is committed; your real .env is gitignored.
#
#   cp .env.local.example .env      then replace the FAKE key with your own Vultr Serverless Inference key
#   scripts/dev.sh --react           control plane :8000, React dashboard :5173, demo-target :8081
#   uv run --project e2e pytest      Playwright + Vultr vision checks of the three front ends (mobile + desktop)
#
# The key is read by the control plane (and the e2e vision check) only. It is never passed into
# sandbox or demo-target containers. Keep the real key in your password vault, not in the repo.

# --- Vultr Serverless Inference (required for live sweeps and vision checks) ---
# Create it in the Vultr portal: Products -> Serverless Inference -> API key.
# A value starting with FAKE is treated as "not set" by the e2e suite (vision checks are skipped).
VULTR_INFERENCE_API_KEY=FAKE-vultr-inference-key-replace-me-0000000000
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=qwen3.8-flash-next
VULTR_INFERENCE_FALLBACK_MODEL=glm-5.3-flash
VULTR_INFERENCE_TIMEOUT_SECONDS=45
VULTR_INFERENCE_MAX_RETRIES=4

# --- Control plane (local) ---
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8000

# --- Built-in demo target (started by scripts/dev.sh as a container on the sandbox network) ---
DEMO_TARGET_PORT=8081
DEMO_TARGET_PUBLIC_URL=http://localhost:8081/demo-target

# --- Sandbox isolation (same caps as the Vultr VM; do not loosen) ---
SANDBOX_IMAGE=safepilot-sandbox:latest
SANDBOX_MEM_LIMIT=512m
SANDBOX_MEMSWAP_LIMIT=512m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_TMPFS_SIZE=128m

# --- e2e suite (optional overrides; these are the defaults) ---
SAFEPILOT_URL=http://127.0.0.1:8000
SAFEPILOT_REACT_URL=http://127.0.0.1:5173
SAFEPILOT_DEMO_URL=http://127.0.0.1:8081/demo-target/

# --- Optional: Vultr v2 API burst path (not used locally) ---
# VULTR_API_KEY=FAKE-vultr-api-key-replace-me-0000000000
# VULTR_REGION=sto
