# SafePilot QA environment template
# Copy to `.env` on the Vultr control plane host only.
# NEVER pass this file, these values, or the host env into sandbox containers.

# --- Vultr Serverless Inference (required) ---
# Create the key in the Vultr customer portal. Store it only on the control plane.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Preferred demo model: paid multimodal, 262K context, 120 RPM / 16 concurrent.
# Do not use `:free` models for the live demo (30 RPM / 4 concurrent, easy 429s).
VULTR_INFERENCE_MODEL=qwen3.8-flash-next
# Fallback multimodal model (1M context, 120 RPM / 16 concurrent):
# VULTR_INFERENCE_MODEL=glm-5.3-flash

# Inference is US-hosted (sea / atl / sjc). Use generous timeouts and retry 429/502/503/504.
VULTR_INFERENCE_TIMEOUT_SECONDS=45
VULTR_INFERENCE_MAX_RETRIES=4

# --- Control plane ---
CONTROL_PLANE_HOST=0.0.0.0
CONTROL_PLANE_PORT=8000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8000

# Built-in adversarial target (served alongside the control plane or as its own container)
DEMO_TARGET_PORT=8081
DEMO_TARGET_PUBLIC_URL=http://localhost:8081/demo-target

# --- Sandbox isolation (must match BUILD_SPEC.md Section 3) ---
SANDBOX_IMAGE=safepilot-sandbox:latest
SANDBOX_MEM_LIMIT=512m
SANDBOX_MEMSWAP_LIMIT=512m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_TMPFS_SIZE=128m

# --- Optional: Vultr v2 API burst path (not required for the Stockholm Docker demo) ---
# Used only if you add a toggle to provision throwaway VMs via POST /v2/instances.
# VULTR_API_KEY=
# VULTR_REGION=sto
# Nearest VX1 regions if you specifically want KVM/Microsandbox: ams, fra, lhr.
# VX1 is not available in sto.
